{
  "name": "safehome-emqx-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=browser --external:node:* --outfile=dist/worker.mjs --metafile=dist/meta.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:workers": "tsx --test --test-concurrency=1 test/workers/*.test.ts",
    "profile:workers": "tsx test/workers/profile.ts",
    "test:rules": "tsx --test --test-concurrency=1 test/emulator/*.test.ts",
    "test:emulators": "firebase emulators:exec --config firebase.local.json --project demo-safehome-backend --only firestore \"npm run test:rules\"",
    "dev": "wrangler dev --local"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "overrides": {
    "miniflare": { "sharp": "0.35.5", "undici": "7.30.1" },
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@firebase/firestore": { "@grpc/grpc-js": "1.14.7" }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.159.0"
  }
}
